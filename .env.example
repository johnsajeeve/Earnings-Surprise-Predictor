# Copy this file to .env and edit it. .env is ignored by git. Never commit real values.
#   cp .env.example .env

# --- Database (PostgreSQL) ---
# The password may contain any characters, including @ : / # ?.
# Changing it after the first start does not change the existing database user. To start over,
# run: docker compose down -v
POSTGRES_USER=earnings
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=earnings

# --- Host ports (bound to 127.0.0.1 only, so nothing is exposed to your network) ---
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Secrets for later stages. Leave these out of this file. ---
# SEC_USER_AGENT is read from your shell environment (set it in ~/.bashrc, decision C-10).
# Docker Compose passes it into the containers. It is deliberately not written here.
# HF_TOKEN, ALPHAVANTAGE_API_KEY and the LLM key are added the same way when needed.
