# Copy this file to .env and edit it. .env is ignored by git. Never commit real values.
#   cp .env.example .env

# --- Database (PostgreSQL) ---
# The password may contain any characters, including @ : / # ?.
# Changing it after the first start does not change the existing database user. To start over,
# run: docker compose down -v
POSTGRES_USER=earnings
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=earnings

# Passwords for the application roles (Database DB-02, decision C-44). Letters and digits are safest.
# Generate one each, for example:  openssl rand -hex 16
# The superuser above only creates the roles and the database.
DB_MIGRATOR_PASSWORD=change-me-migrator
DB_WORKER_PASSWORD=change-me-worker
DB_API_PASSWORD=change-me-api

# Set to true on the machine that runs the daily consensus capture. It makes the worker capture at
# start-up when today has no snapshot (decision C-46). Leave false for tests and CI: true makes
# a freshly started stack call Yahoo. Note: the daily capture itself runs at 22:30 UTC in any stack
# that is still running then, whatever this setting says.
CAPTURE_CATCH_UP=false

# --- Host ports (bound to 127.0.0.1 only, so nothing is exposed to your network) ---
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Secrets for later stages. Leave these out of this file. ---
# SEC_USER_AGENT is read from your shell environment (set it in ~/.bashrc, decision C-10).
# Docker Compose passes it into the containers. It is deliberately not written here.
# HF_TOKEN, ALPHAVANTAGE_API_KEY and the LLM key are added the same way when needed.
# FINNHUB_API_KEY (free key, Data Spike C2) lives in your local .env only. It is not passed to the
# containers, because no code uses it: Finnhub's free plan was tested and not adopted.
